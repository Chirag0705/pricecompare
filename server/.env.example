# Server port
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/pricecompare

# JWT secret (min 32 chars)
JWT_SECRET=change-this-to-a-long-random-secret-string-min-32

# JWT expiry (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Admin seed credentials
ADMIN_EMAIL=admin@pricecompare.local
ADMIN_PASSWORD=AdminPass123!

# CORS allowed origin
CORS_ORIGIN=http://localhost:5173

# Store API credentials (optional in Phase 1; required when Phase 3 activates)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.in
FLIPKART_CLIENT_ID=
FLIPKART_CLIENT_SECRET=
MYNTRA_API_KEY=

# Myntra authorized JSON feed URL (permitted integration path)
MYNTRA_FEED_URL=

# Background sync scheduler
SYNC_ENABLED=true
SYNC_INTERVAL_MS=21600000
SYNC_SEARCH_TERMS=laptop,headphones,smartwatch
